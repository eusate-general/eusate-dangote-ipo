# Copy to .env.local for local development. Never commit real secrets.

# Local Postgres from `docker compose up -d db`. In production use a pooled Neon connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5544/dangote_ipo

# Live answers need a key. For UI work without one, set ANSWER_MODE=mock.
ANTHROPIC_API_KEY=
ANSWER_MODE=live
ANSWER_MODEL=claude-sonnet-5
# low | medium | high. Tune with the eval suite, not by feel.
ANSWER_EFFORT=low

# Daily spend cap in USD (WAT day). Answers stop, gracefully, when it is reached.
DAILY_BUDGET_USD=50

# Bot check (Cloudflare Turnstile, free). Without these, every visitor is treated as verified —
# fine for local dev, NOT safe for a public launch. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile, "Managed" mode, then set:
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# The site key again, but exposed to the browser — Next.js only inlines NEXT_PUBLIC_* vars client-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Signs the "passed the bot check" cookie. Any long random string (`openssl rand -hex 32`).
# Must be set to a real secret before launch; rotating it re-challenges every visitor once.
SESSION_SECRET=

# Owner alerts (see PLAN.md section 7b). Without these, alerts are only logged to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# /admin dashboard (single-user login) at /admin. Without this, /admin/login always rejects.
ADMIN_PASSWORD=

# Forwards homepage lead-form signups to Eusate's own lead pipeline. Without it, leads are still
# stored in the `leads` table, just never forwarded — nothing is lost either way.
LEAD_WEBHOOK_URL=

# Error tracking (Sentry). Without a DSN, the SDK is a no-op — no account exists yet as of writing.
# Create a project at https://sentry.io, Next.js platform, then set:
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps in CI; safe to leave unset (the build just skips that step).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
